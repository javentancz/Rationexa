# Docker Compose exposes PostgreSQL on host port 5433.
DATABASE_URL=postgresql+psycopg://rationexa:rationexa@localhost:5433/rationexa
ARTIFACT_DIR=./artifacts
ARTIFACT_STORAGE=filesystem
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_MODELS=qwen3.5:9b,gemma4:e4b,ornith-1.5:9b
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_STATUS_TIMEOUT_SECONDS=0.75
OLLAMA_STATUS_CACHE_SECONDS=15
PROVIDER_MODEL_CACHE_SECONDS=60
JOB_EXECUTION_MODE=thread
HOSTED_MODE=false
CUSTOM_PROVIDER_ALLOWED_HOSTS=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
PUBLIC_BASE_URL=http://localhost:3000
SHARE_DEFAULT_TTL_DAYS=30
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_COOKIE_NAME=rationexa_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# Stage 2 secrets + auth. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key())"
# With SECRET_ENCRYPTION_KEY set, each signed-in workspace can store its own
# provider credentials. Never use one server-level key as a shared user key.
SECRET_ENCRYPTION_KEY=
# Credentials that the bootstrap local account can log in with.
LOCAL_ACCOUNT_EMAIL=demo@rationexa.local
LOCAL_ACCOUNT_PASSWORD=
# Password recovery. Keep development mode false outside a local machine.
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_DEV_MODE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
