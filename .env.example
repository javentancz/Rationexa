# Docker Compose exposes PostgreSQL on host port 5433.
DATABASE_URL=postgresql+psycopg://rationexa:rationexa@localhost:5433/rationexa
ARTIFACT_DIR=./artifacts
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_MODELS=qwen3.5:9b,gemma4:e4b,ornith-1.5:9b
OLLAMA_TIMEOUT_SECONDS=180
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
PUBLIC_BASE_URL=http://localhost:3000
SHARE_DEFAULT_TTL_DAYS=30
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Stage 2 secrets + auth. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key())"
# With SECRET_ENCRYPTION_KEY set, per-workspace provider keys are decrypted
# from the database; without it, only server-level OPENAI_API_KEY applies.
SECRET_ENCRYPTION_KEY=
# Credentials that the bootstrap local account can log in with.
LOCAL_ACCOUNT_EMAIL=demo@rationexa.local
LOCAL_ACCOUNT_PASSWORD=
