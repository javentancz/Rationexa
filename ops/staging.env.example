# Copy into your staging secret manager. Do not commit populated values.
DATABASE_URL=postgresql+psycopg://rationexa:CHANGE_ME@postgres.internal:5432/rationexa
ARTIFACT_STORAGE=database
# Used only when ARTIFACT_STORAGE=filesystem on a host with a durable volume.
ARTIFACT_DIR=/var/lib/rationexa/artifacts
PUBLIC_BASE_URL=https://staging.rationexa.example
CORS_ORIGINS=https://staging.rationexa.example
NEXT_PUBLIC_API_URL=https://api.staging.rationexa.example
# For a protected Vercel API, point the browser at the same-origin web proxy.
# NEXT_PUBLIC_API_URL=/api/backend
# RATONEXA_API_URL=https://rationexa-api-preview.example
# RATONEXA_API_BYPASS_SECRET=STORE_AS_A_SERVER_ONLY_SECRET

AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama.internal:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_MODELS=qwen3.5:9b,gemma4:e4b,ornith-1.5:9b
OLLAMA_TIMEOUT_SECONDS=180

SECRET_ENCRYPTION_KEY=GENERATE_A_FERNET_KEY
AUTH_SESSION_TTL_HOURS=168
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_DEV_MODE=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_EMAIL=no-reply@rationexa.example
SMTP_USE_TLS=true

SHARE_DEFAULT_TTL_DAYS=30
LOCAL_ACCOUNT_PASSWORD=
