{
  "name": "rationexa",
  "private": true,
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev:web": "pnpm --filter @rationexa/web dev",
    "build:web": "pnpm --filter @rationexa/web build",
    "check": "pnpm --filter @rationexa/web check",
    "validate": "bash scripts/validate.sh",
    "validate:postgres": "bash scripts/validate-postgres.sh"
  }
}
