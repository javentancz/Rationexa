{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,migrations/**/__pycache__/**,**/*.pyc,rationexa.db,artifacts/**}"
    }
  },
  "crons": [
